# Copy to .env and you're ready to run:  cp .env.example .env && docker compose up -d
# Every value below works as-is for local development.

POSTBUCH_ENV=development
POSTBUCH_APP_NAME=Postbuch
POSTBUCH_SECRET_KEY=dev-only-change-me
POSTBUCH_SESSION_COOKIE_NAME=postbuch_session

# --- Database ---
# These three provision the Postgres container (docker-compose reads them).
POSTGRES_DB=postbuch
POSTGRES_USER=postbuch
POSTGRES_PASSWORD=postbuch
# docker-compose overrides this for the web/worker containers; it's here for
# running the app outside Docker.
POSTBUCH_DATABASE_URL=postgresql+psycopg://postbuch:postbuch@db:5432/postbuch

# --- Authentication ---
# Out of the box this runs on developer login: the login page renders a form
# that signs you in with no identity provider. It is refused whenever
# POSTBUCH_ENV=production, so it cannot follow you into a real deployment.
POSTBUCH_DEV_AUTH_ENABLED=true

# Set to true and fill in the values below to use real SSO instead.
POSTBUCH_OIDC_ENABLED=false
POSTBUCH_OIDC_SERVER_METADATA_URL=
POSTBUCH_OIDC_CLIENT_ID=postbuch
POSTBUCH_OIDC_CLIENT_SECRET=
POSTBUCH_OIDC_SCOPES=openid profile email

# --- Object storage (S3-compatible) ---
# Defaults target the bundled MinIO container, so document upload and OCR work
# with no cloud account. For production, point these at any S3-compatible
# provider (AWS, Hetzner, Cloudflare R2, Backblaze B2, your own MinIO).
POSTBUCH_S3_ENDPOINT=http://minio:9000
POSTBUCH_S3_REGION=us-east-1
POSTBUCH_S3_ACCESS_KEY_ID=minioadmin
POSTBUCH_S3_SECRET_ACCESS_KEY=minioadmin
POSTBUCH_S3_BUCKET=postbuch
POSTBUCH_S3_KEY_PREFIX=uploads
POSTBUCH_S3_PRESIGNED_URL_TTL_SECONDS=3600
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Legacy one-time migration source for existing local files.
POSTBUCH_STORAGE_ROOT=/data/storage

# --- Mail ingestion ---
# IMAP credentials live per-mailbox in the database (mailboxes table):
# imap_host, imap_port, imap_use_ssl, imap_username, imap_password.
# With no mailboxes configured the worker simply idles. Interval applies to all.
POSTBUCH_IMAP_POLL_SECONDS=300

# --- OCR ---
POSTBUCH_OCR_LANGUAGE=deu+eng
POSTBUCH_OCR_MIN_TEXT_LENGTH=80

# --- Host port bindings ---
# Override any of these if a port is already in use on your machine.
POSTBUCH_HTTP_PORT=8000
POSTBUCH_MINIO_PORT=9012
POSTBUCH_MINIO_CONSOLE_PORT=9013
